# Public DNS name or public IPv4 address, without scheme or port.
PEERDESK_HOST=assist.example.com
PEERDESK_STUN_PORT=3478
PEERDESK_HTTP_PORT=8787
# Comma-separated initial administrator email addresses. Keep the current admin listed during upgrades.
PEERDESK_ADMIN_EMAILS=
# Optional public STUN endpoints, separated by commas.
PEERDESK_STUN_URLS=

# Leave TURN settings blank for STUN-only operation.
TURN_URLS=
# Set TURN_SHARED_SECRET and TURN_EXTERNAL_IP to enable the bundled coturn service.
# TURN_EXTERNAL_IP uses public-ip/private-ip when the server is behind NAT.
TURN_SHARED_SECRET=
# Example: 203.0.113.10/10.0.0.17
TURN_EXTERNAL_IP=
# Open the relay port range in the cloud firewall.
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# External TURN credentials can be used instead of TURN_SHARED_SECRET.
# Or external managed TURN credentials:
TURN_EXTERNAL_USERNAME=
TURN_EXTERNAL_CREDENTIAL=
